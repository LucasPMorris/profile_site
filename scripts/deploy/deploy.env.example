# Deploy target configuration. Copy to `deploy.env` (gitignored) and fill in.
#   cp scripts/deploy/deploy.env.example scripts/deploy/deploy.env
#
# Nothing secret belongs in here. Application secrets live in
# `$DEPLOY_ROOT/shared/app.env` on the server and never leave it.

# ─── SSH target ───────────────────────────────────────────────────────────
DEPLOY_HOST=192.168.1.113
DEPLOY_USER=geekom
DEPLOY_SSH_PORT=22

# ─── Server layout ────────────────────────────────────────────────────────
# Absolute path, not ~. This file is sourced on the DEV box, so a tilde would
# expand against the wrong home. Capistrano-style: repo/ is the fetch mirror,
# releases/<stamp> are immutable checkouts, current -> the live one, shared/
# survives every deploy.
DEPLOY_ROOT=/home/geekom/node/profile_site
DEPLOY_BRANCH=main

# Note the host: `github-profile-site`, not `github.com`. A GitHub deploy key is
# bound to exactly one repository, and the geekom's default key is already spoken
# for by lir-app. setup/bootstrap.sh generates a second key and writes a matching
# Host alias into ~/.ssh/config so both repos can be pulled from one machine.
DEPLOY_REPO_URL=git@github-profile-site:LucasPMorris/profile_site.git

# ─── Runtime ──────────────────────────────────────────────────────────────
APP_SERVICE=profile-site
APP_PORT=4060
# Path curl hits to decide the new release is alive. `/` is the homepage; this
# app has no dedicated health endpoint.
HEALTH_PATH=/
HEALTH_TIMEOUT=120

# ─── Housekeeping ─────────────────────────────────────────────────────────
# Old releases kept on disk for rollback. node_modules is hardlinked between
# releases whose package-lock.json matches, so each extra release is cheap.
KEEP_RELEASES=5
